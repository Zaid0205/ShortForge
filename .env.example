# Copy to .env and fill in. Only the keys for the providers you select are required.

# --- Script generation (required) ---
# https://console.groq.com/keys
GROQ_API_KEY=
# Must support strict structured outputs: https://console.groq.com/docs/structured-outputs
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high. Higher is slower but counts words more reliably.
GROQ_REASONING_EFFORT=medium
# Second pass that critiques and rewrites each script (hook, analogy, jargon, accuracy, ending)
SCRIPT_EDITOR=true

# --- Channel ---
CHANNEL_NICHE=AI tools and tech concepts, explained in 45 seconds

# --- Text to speech: kokoro (local, free) ---
TTS_PROVIDER=kokoro
# Voice IDs start with a (American) or b (British). List: https://huggingface.co/hexgrad/Kokoro-82M
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# --- Images ---
# generated: every scene image is generated (default)
# hybrid: a real Pexels stock photo per scene, generated only when none fits
IMAGE_SOURCE=generated
# Only needed for hybrid. https://www.pexels.com/api/
PEXELS_API_KEY=

# Image generation: cloudflare (free daily tier)
IMAGE_PROVIDER=cloudflare

# Cloudflare dashboard > Workers AI. The API token needs the "Workers AI: Read" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# FLUX.2 klein renders 720x1280 directly. @cf/black-forest-labs/flux-1-schnell also works.
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Diffusion steps for flux-1-schnell only (1 to 8); FLUX.2 klein uses a fixed 4.
CLOUDFLARE_STEPS=4

# Appended to every image prompt so all scenes share one look
IMAGE_STYLE=realistic documentary photograph, natural light, true-to-life colors, sharp focus, shot on a full-frame camera, vertical composition, subject large in frame

# --- YouTube upload (only used with --upload) ---
# OAuth client of type "Desktop app" from Google Cloud Console, with YouTube Data API v3 enabled
YOUTUBE_CLIENT_SECRET=client_secret.json
# Cached login, created on first upload. Both files are gitignored.
YOUTUBE_TOKEN=token.json
# private | unlisted | public. Unverified API projects can only upload private videos.
YOUTUBE_PRIVACY=private

# --- Runtime ---
OUTPUT_DIR=output
DEFAULT_SCENES=6
MAX_RETRIES=4
